# Byte-compiled / cache / test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
*.log
*.tmp

# Virtual environments & Node / JS / Rust artifacts
.venv/
venv/
node_modules/
.next/
dist/
build/
target/
archive/

# Environment files & local DBs
.env
.env.local
.env*.local
!.env.example
*.db
*.sqlite
*.sqlite3

# OS metadata
.DS_Store
Thumbs.db

# Exclusions
dcozi/
~dcozi/

# ONNX Model Weights (>100MB; downloaded via FaceRecog-Engine/download_models.py)
FaceRecog-Engine/models/**/*.onnx
FaceRecog-Engine/models/**/*.zip
!FaceRecog-Engine/models/.gitkeep

# Local runtime state & vault secrets (never commit user secrets/scores)
settings.json
stats.json
*.vhdx
*.secret
*.pkl
*.dpapi
RECOVERY_KEY*.txt
