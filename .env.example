# Environment configuration for LockerDrive local vault runtime
# Copy to .env as needed — never commit .env or vault secrets.

# Target storage drive & VHDX container paths
LOCKERDRIVE_DRIVE_ROOT=E:\\
LOCKERDRIVE_HOST_DIR=E:\LockerDrive
LOCKERDRIVE_VHDX_PATH=E:\LockerDrive\lockerdrive.vhdx

# Drive letter assigned when vault is unlocked & mounted
LOCKERDRIVE_MOUNT_LETTER=V

# Optional PIN override for setup/restore_real_vault_state.py recovery script (4-12 digits)
# Leave blank in normal operation.
LOCKERDRIVE_RESET_PIN=
